{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["src/*"],
      "@api/*": ["../api/src/*"]
    },
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src", "vite.config.ts", "vitest.storybook.config.ts", ".storybook/*.ts", ".storybook/*.tsx"]
}
