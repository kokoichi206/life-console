{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "life-console",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "production",
    "PHOTO_UPLOAD_MODE": "worker"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "life-console",
      "database_id": "replace-with-private-database-id",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEAL_PHOTOS",
      "bucket_name": "life-console-meal-photos"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
