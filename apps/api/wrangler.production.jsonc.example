{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "life-console",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "life-console",
      "database_id": "replace-with-private-database-id",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "main": "dist/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "APP_ENV": "production",
    "PHOTO_UPLOAD_MODE": "worker"
  },
  "r2_buckets": [
    {
      "binding": "MEAL_PHOTOS",
      "bucket_name": "life-console-meal-photos"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
