LIFE_CONSOLE_API_URL=http://localhost:8788
LIFE_CONSOLE_RUNNER_ID=mac-local
LIFE_CONSOLE_RUNNER_NAME=Local Mac
LIFE_CONSOLE_RUNNER_TOKEN=local-runner-token
APP_ENV=local
LIFE_CONSOLE_POLL_SECONDS=60
LIFE_CONSOLE_HEARTBEAT_SECONDS=60

# 実際の値と絶対パスは private な環境変数または secret store に置く。
SLACK_WORKSPACE=
SLACK_SEARCH_QUERY=
CHATWORK_ACCOUNT=
CHATWORK_ROOM_IDS=
# 未設定時は Gmail 対応アカウントが 1 件の場合のみ自動選択する。
GMAIL_ACCOUNT=
GMAIL_SEARCH_QUERY='in:inbox category:primary newer_than:7d -in:sent -in:drafts'
TALKNOTE_ACCOUNT=
OBSIDIAN_VAULT_PATH=
WEIGHT_CSV_PATH=
FINANCE_CSV_PATH=
BACKUP_DIRECTORY=
CLOUDFLARE_D1_DATABASE_NAME=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCOUNT_ID=
WRANGLER_BIN=
LIFE_CONSOLE_REPOSITORY_ROOT=

# backup job が aws CLI 経由で R2 object を同期するために使う。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudflare Access の Service Auth token。両方を同時に設定する。
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
