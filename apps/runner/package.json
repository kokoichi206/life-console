{
  "name": "@life-console/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "life-console-runner": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform node --target node24 --clean",
    "dev": "tsx src/index.ts",
    "dev:once": "tsx src/index.ts --once",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@life-console/contracts": "workspace:*",
    "csv-parse": "^7.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
