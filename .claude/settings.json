{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "respectGitignore": true,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1200000"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-after-edit.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
