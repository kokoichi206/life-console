root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Test
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# 通信とログインを専用の境界に閉じ込める。
[app/src/**.kt]
life_console_forbidden_import_prefixes = android.webkit, java.net, javax.net, okhttp3, retrofit2

[app/src/main/java/dev/kokoichi/lifeconsole/WidgetSyncService.kt]
life_console_forbidden_import_prefixes = okhttp3, retrofit2

[app/src/main/java/dev/kokoichi/lifeconsole/WidgetLoginActivity.kt]
life_console_forbidden_import_prefixes = java.net, javax.net, okhttp3, retrofit2
