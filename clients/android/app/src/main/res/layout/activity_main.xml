<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="28dp" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/brand" android:textColor="#086B6D"
                android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/heading"
                android:textColor="#202333" android:textSize="30sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_instructions"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/widget_instructions"
                android:textColor="#535868" android:textSize="16sp" android:lineSpacingExtra="5dp" />
            <include layout="@layout/weight_widget"
                android:layout_width="220dp" android:layout_height="100dp"
                android:layout_marginTop="28dp" android:layout_gravity="center_horizontal" />
            <Button android:id="@+id/add_weight_widget"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="28dp" android:text="@string/add_weight_widget"
                android:textColor="#FFFFFF" android:backgroundTint="#086B6D"
                android:textAllCaps="false" />
            <Button android:id="@+id/open_weight"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="@string/open_weight" android:textColor="#086B6D"
                android:backgroundTint="#E4EEEE" android:textAllCaps="false" />
            <include layout="@layout/meal_widget"
                android:layout_width="220dp" android:layout_height="100dp"
                android:layout_marginTop="28dp" android:layout_gravity="center_horizontal" />
            <Button android:id="@+id/add_meal_widget"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="28dp" android:text="@string/add_meal_widget"
                android:textColor="#FFFFFF" android:backgroundTint="#086B6D"
                android:textAllCaps="false" />
            <Button android:id="@+id/open_meal"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="@string/open_meal" android:textColor="#086B6D"
                android:backgroundTint="#E4EEEE" android:textAllCaps="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/login_hint"
                android:textColor="#535868" android:textSize="13sp" />
        </LinearLayout>
</ScrollView>
