{
  "name": "life-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @life-console/web build && pnpm --filter @life-console/api build && pnpm --filter @life-console/runner build",
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors cyan,magenta \"pnpm dev:api\" \"pnpm --filter @life-console/web dev\"",
    "dev:api": "pnpm --filter @life-console/api dev",
    "dev:runner": "pnpm --filter @life-console/runner dev",
    "dev:runner:once": "pnpm --filter @life-console/runner dev:once",
    "local:setup": "pnpm --filter @life-console/web build && pnpm --filter @life-console/database migrate:local && pnpm --filter @life-console/database seed:local",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-yml": "^3.8.1",
    "jsonc-eslint-parser": "^3.3.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "yaml-eslint-parser": "^2.1.0"
  }
}
