{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'schedule:earlyMondays',
    ':enableVulnerabilityAlertsWithLabel(security)',
    'helpers:pinGitHubActionDigestsToSemver',
  ],
  timezone: 'Asia/Tokyo',
  baseBranchPatterns: ['develop'],
  // 更新ブランチへの手動修正を、自動 rebase で上書きしない。
  rebaseWhen: 'never',
  automerge: false,
  labels: ['dependencies'],
  packageRules: [
    {
      matchManagers: ['github-actions'],
      groupName: 'GitHub Actions',
      groupSlug: 'github-actions',
    },
    {
      // 全 workspace が同じ pnpm-lock.yaml を共有するため、まとめて更新する。
      matchManagers: ['npm'],
      groupName: 'npm dependencies',
      groupSlug: 'npm-updates',
    },
    {
      matchFileNames: ['infra/terraform/**'],
      groupName: 'terraform dependencies',
      groupSlug: 'terraform-updates',
      rangeStrategy: 'update-lockfile',
    },
    {
      matchManagers: ['gradle', 'gradle-wrapper'],
      groupName: 'Android dependencies',
      groupSlug: 'android-updates',
    },
    {
      // 公式コンテナのブラウザと npm パッケージは同じバージョンが必要。
      matchPackageNames: ['playwright', 'mcr.microsoft.com/playwright'],
      groupName: 'Playwright',
      groupSlug: 'playwright',
    },
  ],
  vulnerabilityAlerts: {
    labels: ['security', 'dependencies'],
  },
}
