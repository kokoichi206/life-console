{
  "name": "@life-console/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply life-console-local --local --config ../../apps/api/wrangler.jsonc",
    "seed:local": "wrangler d1 execute life-console-local --local --config ../../apps/api/wrangler.jsonc --file ./seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.127.1"
  }
}
